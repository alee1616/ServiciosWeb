<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" style="-fx-background-color: #ECFDF5;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.serviciosweb.controller.CustomerController">

    <HBox alignment="CENTER_LEFT" style="-fx-background-color: #047857;">
        <padding>
            <Insets top="14" right="20" bottom="14" left="20"/>
        </padding>
        <Label text="Consulta de clientes - API REST"
               style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
    </HBox>

    <VBox spacing="14" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="16" right="20" bottom="16" left="20"/>
        </padding>

        <HBox spacing="14" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(4,120,87,0.20), 8, 0, 0, 2);">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>

            <Button fx:id="btnConsultar" text="Consultar clientes" onAction="#consultarClientes"
                    prefWidth="170"
                    style="-fx-background-color: #10B981; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;"/>

            <Label fx:id="lblEstado" text="Presione Consultar clientes"
                   style="-fx-text-fill: #065F46;"/>
        </HBox>

        <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12;
                          -fx-border-color: #A7F3D0;
                          -fx-effect: dropshadow(gaussian, rgba(4,120,87,0.20), 8, 0, 0, 2);">
            <placeholder>
                <Label text="Tabla sin contenido" style="-fx-text-fill: #065F46;"/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="90"/>
                <TableColumn fx:id="colApellido" text="Apellido" prefWidth="100"/>
                <TableColumn fx:id="colCorreo" text="Correo" prefWidth="190"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110"/>
                <TableColumn fx:id="colPais" text="País" prefWidth="80"/>
                <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="90"/>
                <TableColumn fx:id="colIngreso" text="Ingreso anual" prefWidth="100"/>
                <TableColumn fx:id="colScore" text="Score" prefWidth="60"/>
                <TableColumn fx:id="colDeuda" text="Deuda" prefWidth="60"/>
                <TableColumn fx:id="colEstadoCliente" text="Estado" prefWidth="80"/>
            </columns>
        </TableView>
    </VBox>
</VBox>