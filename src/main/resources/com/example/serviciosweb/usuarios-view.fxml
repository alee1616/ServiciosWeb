<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.serviciosweb.controller.UsuariosController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Consulta de usuarios - API REST"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnConsultar" text="Consultar usuarios" onAction="#consultarUsuarios"/>
        <Label fx:id="lblEstado" text="Presione Consultar usuarios"/>
    </HBox>

    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Tabla sin contenido"/>
        </placeholder>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="colUsername" text="Username" prefWidth="110"/>
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="180"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="130"/>
            <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="110"/>
            <TableColumn fx:id="colEmpresa" text="Empresa" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>